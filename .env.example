# Database Configuration( PostgreSQL )
DB_NAME="bind_dns"
DB_USER="postgres"
DB_PORT="5643"
DB_ADDR="10.2.3.4"
DB_PASS="password"
# leave empty for default
DB_MAX_CONNS="15"
DB_MIN_CONNS="5"

# HTTP Configuration
LISTEN_ADDR="0.0.0.0"
LISTEN_PORT="80"

# Git Configuration
GIT_URL="https://github.com/username/repo.git" # or "git@github.com:username/repo.git"
GIT_NAME="username"
GIT_EMAIL="email@example.com"
# Both SSH and HTTP are supported, if token is not set, SSH will be used, local machine SSH agent must be configured with appropriate public key to push
GIT_TOKEN="your_git_token"