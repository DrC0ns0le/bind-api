FROM golang:1.25-alpine

# Set workdir
WORKDIR /app

# Install any build/runtime deps you normally need here
# (add apk packages if your main Dockerfile uses them)
RUN apk add --no-cache ansible openssh-client sshpass && rm -rf /root/.cache /var/cache/apk/*

# Copy go module files first (for better caching when you do rebuild)
COPY go.mod go.sum ./
RUN go mod download

# Source code will be mounted at runtime via docker-compose

# Expose the same port your app listens on in main.go / docker-compose.yml
EXPOSE 8080

# Default dev command: run the main package (includes main.go, router.go, etc.)
CMD ["go", "run", "."]
