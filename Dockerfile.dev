# syntax=docker/dockerfile:1.4

FROM golang:1.25-alpine

# Set workdir
WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ansible openssh-client sshpass git ca-certificates && \
    rm -rf /root/.cache /var/cache/apk/*

# Copy go module files first for better caching
COPY go.mod go.sum ./

# Download dependencies with cache mount
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Source code will be mounted at runtime via docker-compose

# Expose the same port your app listens on in main.go / docker-compose.yml
EXPOSE 8080

# Default dev command: run the main package (includes main.go, router.go, etc.)
CMD ["go", "run", "."]
